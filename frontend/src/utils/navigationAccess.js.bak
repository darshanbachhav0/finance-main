  "/treasury/transfers": "Transfers",
  "/accounting": "Accounting Entries",
  "/accounting/periods": "Accounting Periods",
  "/accounting/sire": "SIRE Export",
  "/budget": "Budget Control",
  "/reports": "Reports",
  "/management-view": "Management Portal",
