PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/erp_financial_system
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
CLIENT_URLS=http://localhost:5174,http://127.0.0.1:5174
UPLOAD_DIR=backend/uploads
JSON_BODY_LIMIT=2mb
FORM_BODY_LIMIT=2mb

# ============================================================
# SUNAT - CONSULTA RUC (public SUNAT website)
# ============================================================
# CONSULTA_RUC (the default) verifies each supplier RUC on
# SUNAT's public Consulta RUC page, in a headless browser, and
# keeps its whole profile: legal name, status, domicile
# condition, taxpayer type, activities, voucher systems, etc.
# No SOL user, client_id or client_secret, and no Padron file.
#
# It needs Chromium: run `npx playwright install chromium` once,
# or point PLAYWRIGHT_EXECUTABLE_PATH at an installed Chromium
# browser, e.g. on Windows:
# PLAYWRIGHT_EXECUTABLE_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
#
# IMPORTANT:
# It DOES NOT prove that a specific CPE/invoice exists or is
# accepted by SUNAT (Accounting's manual SUNAT exception does).
#
# Other modes, only when set explicitly: PADRON (downloaded
# public Padron), PRODUCTION (contracted CPE API), MANUAL.
SUNAT_PROVIDER_MODE=CONSULTA_RUC
PLAYWRIGHT_EXECUTABLE_PATH=

# SIRE / RCE export (Accounting > SIRE): UMA's own RUC and legal name exactly as registered with
# SUNAT, and the IGV columns confirmed by UMA's accounting (DNG). See docs/OPERATIONS.md.
SIRE_TAXPAYER_RUC=20550807123
SIRE_TAXPAYER_NAME=UNIVERSIDAD MARIA AUXILIADORA S.A.C.
SIRE_RCE_IGV_DESTINATION=DNG

SUNAT_PADRON_INFO_URL=https://www.sunat.gob.pe/descargaPRR/mrc137_padron_reducido.html

SUNAT_PADRON_DOWNLOAD_URL=https://www2.sunat.gob.pe/padron_reducido_ruc.zip

# Check for a newer PadrÃ³n every 24 hours.
SUNAT_PADRON_REFRESH_HOURS=24

# If SUNAT is temporarily unavailable, an already downloaded
# dataset can still be used for up to this many days.
SUNAT_PADRON_MAX_STALE_DAYS=7

SUNAT_PADRON_REQUEST_TIMEOUT_MS=120000

# Leave blank to use:
# backend/data/sunat-padron
SUNAT_PADRON_DATA_DIR=

# 5 GiB safety limit for the uncompressed TXT.
SUNAT_PADRON_MAX_UNCOMPRESSED_BYTES=5368709120

# Legal representatives are retrieved using full Chromium in headless mode.
# No desktop browser window is opened. Install with: npx playwright install chromium
# Visible mode is no longer supported, even if an old launcher sets it to false.
SUNAT_REPRESENTATIVES_DEBUG=false
SUNAT_CONSULTA_RUC_TIMEOUT_MS=30000
SUNAT_CONSULTA_RUC_CACHE_MINUTES=30


# ============================================================
# SUNAT FISCAL VALIDATION / EXCHANGE-RATE ADAPTER
# ============================================================
# PADRON verifies suppliers only. Invoice posting requires an authenticated
# invoice validation endpoint; PRODUCTION also uses the taxpayer endpoint.
# Configure an UMA-approved adapter to the official service and certify its
# response contract before live use. OAuth client keys alone do not configure
# this adapter.
SUNAT_API_BASE_URL=
SUNAT_API_TOKEN=
SUNAT_TAXPAYER_ENDPOINT=
SUNAT_VOUCHER_ENDPOINT=
SUNAT_EXCHANGE_RATE_ENDPOINT=
SUNAT_API_METHOD=POST
SUNAT_API_TIMEOUT_MS=15000

# BBVA configuration and PEN/USD certification are stored in the database.
# There is no demo bank serializer or BANK_FILE_MODE environment switch.
# Production always requires a MongoDB replica set. To enforce this locally:
# REQUIRE_ATOMIC_WRITES=true

# ============================================================
# TRIPLE-TRACK BATCH WORKER
# ============================================================

BATCH_INVOICE_POLL_MS=5000

BATCH_INVOICE_WORKER_CONCURRENCY=3

BATCH_INVOICE_STALE_MINUTES=15

BATCH_INVOICE_INLINE_PROCESSING=false


# ============================================================
# BATCH UPLOAD SAFETY LIMITS
# ============================================================

BATCH_MAX_ENTRIES=500

BATCH_MAX_ENTRY_BYTES=10485760

BATCH_MAX_UNCOMPRESSED_BYTES=104857600

BATCH_MAX_COMPRESSION_RATIO=100

BATCH_MAX_EXCEL_ROWS=5000

# Stable secret for private draft encryption. Back this up separately from MongoDB.
# Set before first use. If omitted, JWT_SECRET is used; changing either active secret
# without migrating drafts makes previously encrypted drafts unreadable.
DRAFT_ENCRYPTION_KEY=

# Padrón web startup and lookups never run a full import.
# Use an absolute persistent directory, shared with exactly one updater.
# SUNAT_PADRON_DATA_DIR=/var/lib/uma/sunat-padron
# Worker: npm run sunat:padron:worker --workspace backend
# First deployment: npm run sunat:padron:bootstrap --workspace backend
SUNAT_PADRON_MIN_ROWS=100000
SUNAT_PADRON_MIN_ROW_RATIO=0.8

# Authoritative SUNAT adapter: date = actual publication date, sellingRate, source = SUNAT.
# Configure SUNAT_API_BASE_URL, SUNAT_API_TOKEN and SUNAT_EXCHANGE_RATE_ENDPOINT.
# PUBLIC_PADRON can keep local RUC lookup and use SUNAT_VOUCHER_ENDPOINT for invoices.
# BCRP/manual references are opt-in fallbacks and never authoritative.
EXCHANGE_RATE_ALLOW_REFERENCE_FALLBACK=false

# Run a supervised process: npm run worker:sla --workspace backend
# Use the same values in the API and worker environments.
SLA_DUE_SOON_HOURS=4
# Approval SLAs count Peruvian working days (weekends, national holidays and
# UMA_EXTRA_HOLIDAYS excluded). One approval step's SLA, and how many further
# working days an overdue step waits before escalating to the approver's jefe.
APPROVAL_SLA_WORKING_DAYS=1
SLA_ESCALATION_WORKING_DAYS=1
SLA_POLL_MS=60000

# Render Free: durable per-RUC public taxpayer cache in the existing MongoDB.
# Set MONGO to avoid full Padrón indexing; blank preserves disk-based operation.
SUNAT_TAXPAYER_CACHE_MODE=

# ============================================================
# NOTIFICATION EMAILS (docs/OPERATIONS.md §4 "Notification emails")
# ============================================================
# OFF = no emails; LOG = print each email to the console instead of sending (development);
# SMTP = send through the SMTP server below.
NOTIFICATION_EMAIL_MODE=OFF
# Development: run the sender inside `npm run dev` (it is on by default only in production).
# NOTIFICATION_EMAIL_WORKER_ENABLED=true
# Address of the web app, for the "Abrir en el sistema" links (default: first CLIENT_URLS entry).
APP_PUBLIC_URL=http://localhost:5174
# Microsoft 365: smtp.office365.com:587 with the sender mailbox's user and password.
# Gmail: smtp.gmail.com:587, SMTP_USER = the Gmail address, SMTP_PASSWORD = a 16-character App
# Password (needs 2-Step Verification; the normal Gmail password is rejected). Never commit it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM="UMA Finanzas <notificaciones@uma.edu.pe>"
# NOTIFICATION_EMAIL_REPLY_TO=
# Only email these domains, e.g. uma.edu.pe (blank = any address saved on the user).
NOTIFICATION_EMAIL_ALLOWED_DOMAINS=
# 0 = email as soon as the notification is created; a few minutes skips alerts already read in the app.
NOTIFICATION_EMAIL_DELAY_MINUTES=0
NOTIFICATION_EMAIL_POLL_MS=30000
NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
# DAILY (default): one summary email per person each working day at NOTIFICATION_EMAIL_DIGEST_HOUR
# (Lima). IMMEDIATE: one email per notification. Each person can change it in their account menu.
NOTIFICATION_EMAIL_FREQUENCY=DAILY
NOTIFICATION_EMAIL_DIGEST_HOUR=8
# Automatic follow-ups (operations worker): remind a requester whose request was sent back after
# N working days; close drafts untouched for N days (0 = never), warning N days before; tell
# Treasury N working days before each 15th / 30th payment run.
FOLLOW_UP_RETURNED_WORKING_DAYS=2
DRAFT_AUTO_CLOSE_DAYS=30
DRAFT_CLOSE_WARNING_DAYS=5
PAYMENT_RUN_NOTICE_WORKING_DAYS=2
# Weekly Excel report emailed to Finance and Management (needs notification emails on).
WEEKLY_REPORT_ENABLED=true
# 1 = Monday ... 7 = Sunday; hour in Lima time.
WEEKLY_REPORT_DAY=1
WEEKLY_REPORT_HOUR=8
WEEKLY_REPORT_ROLES=Accounting,Treasury,Budget,Management
# Super Admin (see docs/OPERATIONS.md): encrypts authenticator secrets; set a long random value.
# TWO_FACTOR_ENCRYPTION_KEY=replace_with_a_long_random_secret
# Where backups are written (npm run backup and the Super Admin console).
# BACKUP_DIR=backend/backups
