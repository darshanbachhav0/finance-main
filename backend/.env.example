PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/erp_financial_system
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
CLIENT_URLS=http://localhost:5174,http://127.0.0.1:5174
UPLOAD_DIR=backend/uploads
JSON_BODY_LIMIT=2mb
FORM_BODY_LIMIT=2mb

# ============================================================
# SUNAT - PUBLIC PADRON REDUCIDO RUC
# ============================================================
# PADRON uses SUNAT's official public downloadable Padron.
# It requires no SOL user, client_id or client_secret.
#
# IMPORTANT:
# This validates the supplier RUC, legal name, taxpayer status
# and domicile condition.
#
# It DOES NOT prove that a specific CPE/invoice exists or is
# accepted by SUNAT.
SUNAT_PROVIDER_MODE=PADRON

SUNAT_PADRON_INFO_URL=https://www.sunat.gob.pe/descargaPRR/mrc137_padron_reducido.html

SUNAT_PADRON_DOWNLOAD_URL=https://www2.sunat.gob.pe/padron_reducido_ruc.zip

# Check for a newer PadrÃ³n every 24 hours.
SUNAT_PADRON_REFRESH_HOURS=24

# If SUNAT is temporarily unavailable, an already downloaded
# dataset can still be used for up to this many days.
SUNAT_PADRON_MAX_STALE_DAYS=7

SUNAT_PADRON_REQUEST_TIMEOUT_MS=120000

# Leave blank to use:
# backend/data/sunat-padron
SUNAT_PADRON_DATA_DIR=

# 5 GiB safety limit for the uncompressed TXT.
SUNAT_PADRON_MAX_UNCOMPRESSED_BYTES=5368709120

# Legal representatives are retrieved using full Chromium in headless mode.
# No desktop browser window is opened. Install with: npx playwright install chromium
# Visible mode is no longer supported, even if an old launcher sets it to false.
SUNAT_REPRESENTATIVES_DEBUG=false
SUNAT_CONSULTA_RUC_TIMEOUT_MS=30000
SUNAT_CONSULTA_RUC_CACHE_MINUTES=30


# ============================================================
# OPTIONAL FUTURE OFFICIAL SUNAT CPE API
# ============================================================
# These are NOT required while SUNAT_PROVIDER_MODE=PADRON.
#
# If UMA later receives SUNAT API credentials, change:
#
# SUNAT_PROVIDER_MODE=PRODUCTION
#
# and configure the following.
SUNAT_CONSULTING_RUC=
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=

SUNAT_API_SCOPE=https://api.sunat.gob.pe/v1/contribuyente/contribuyentes

SUNAT_TOKEN_URL_TEMPLATE=https://api-seguridad.sunat.gob.pe/v1/clientesextranet/{clientId}/oauth2/token/

SUNAT_VALIDATION_URL_TEMPLATE=https://api.sunat.gob.pe/v1/contribuyente/contribuyentes/{ruc}/validarcomprobante

SUNAT_API_TIMEOUT_MS=15000
SUNAT_TOKEN_REFRESH_SKEW_SECONDS=60
SUNAT_EXCHANGE_RATE_ENDPOINT=


FX_ALLOW_BCRP_FALLBACK=false

BANK_FILE_MODE=DEMO


# ============================================================
# TRIPLE-TRACK BATCH WORKER
# ============================================================

BATCH_INVOICE_POLL_MS=5000

BATCH_INVOICE_WORKER_CONCURRENCY=3

BATCH_INVOICE_STALE_MINUTES=15

BATCH_INVOICE_INLINE_PROCESSING=false


# ============================================================
# BATCH UPLOAD SAFETY LIMITS
# ============================================================

BATCH_MAX_ENTRIES=500

BATCH_MAX_ENTRY_BYTES=10485760

BATCH_MAX_UNCOMPRESSED_BYTES=104857600

BATCH_MAX_COMPRESSION_RATIO=100

BATCH_MAX_EXCEL_ROWS=5000

# Stable secret for private draft encryption. Back this up separately from MongoDB.
# Set before first use. If omitted, JWT_SECRET is used; changing either active secret
# without migrating drafts makes previously encrypted drafts unreadable.
DRAFT_ENCRYPTION_KEY=

# Padrón web startup and lookups never run a full import.
# Use an absolute persistent directory, shared with exactly one updater.
# SUNAT_PADRON_DATA_DIR=/var/lib/uma/sunat-padron
# Worker: npm run sunat:padron:worker --workspace backend
# First deployment: npm run sunat:padron:bootstrap --workspace backend
SUNAT_PADRON_MIN_ROWS=100000
SUNAT_PADRON_MIN_ROW_RATIO=0.8
