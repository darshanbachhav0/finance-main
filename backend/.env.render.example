NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/uma_finance
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=8h
DRAFT_ENCRYPTION_KEY=generate-and-back-up-a-separate-long-random-secret
CLIENT_URLS=https://YOUR-SERVICE.onrender.com
UMA_STORAGE_ROOT=/var/data
SUNAT_PADRON_DATA_DIR=/var/data/sunat-padron
SUNAT_PROVIDER_MODE=PADRON
EXCHANGE_RATE_ALLOW_REFERENCE_FALLBACK=true
# SIRE / RCE export (Accounting > SIRE): UMA's own RUC and legal name exactly as registered with
# SUNAT, and the IGV columns confirmed by UMA's accounting (DNG). See docs/OPERATIONS.md.
SIRE_TAXPAYER_RUC=20550807123
SIRE_TAXPAYER_NAME=UNIVERSIDAD MARIA AUXILIADORA S.A.C.
SIRE_RCE_IGV_DESTINATION=DNG
SIRE_RCE_BOOK_CURRENCY=PEN
MANAGEMENT_API_CACHE_SECONDS=15
MANAGEMENT_API_RATE_LIMIT=240
BANK_FILE_MODE=PRODUCTION
BATCH_INVOICE_INLINE_PROCESSING=false
NOTIFICATION_EMAIL_MODE=SMTP
APP_PUBLIC_URL=https://YOUR-SERVICE.onrender.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notificaciones@uma.edu.pe
SMTP_PASSWORD=the-sender-mailbox-password
NOTIFICATION_EMAIL_FROM="UMA Finanzas <notificaciones@uma.edu.pe>"
# Super Admin (see docs/OPERATIONS.md): encrypts authenticator secrets; set a long random value.
TWO_FACTOR_ENCRYPTION_KEY=generate-a-separate-long-random-secret
# Where backups are written (npm run backup and the Super Admin console): the persistent disk.
BACKUP_DIR=/var/data/backups
