NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/uma_finance
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=8h
DRAFT_ENCRYPTION_KEY=generate-and-back-up-a-separate-long-random-secret
CLIENT_URLS=https://YOUR-SERVICE.onrender.com
UMA_STORAGE_ROOT=/var/data
SUNAT_PADRON_DATA_DIR=/var/data/sunat-padron
SUNAT_PROVIDER_MODE=PADRON
MANAGEMENT_API_CACHE_SECONDS=15
MANAGEMENT_API_RATE_LIMIT=240
BANK_FILE_MODE=PRODUCTION
BATCH_INVOICE_INLINE_PROCESSING=false
NOTIFICATION_EMAIL_MODE=SMTP
APP_PUBLIC_URL=https://YOUR-SERVICE.onrender.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notificaciones@uma.edu.pe
SMTP_PASSWORD=the-sender-mailbox-password
NOTIFICATION_EMAIL_FROM="UMA Finanzas <notificaciones@uma.edu.pe>"
NOTIFICATION_EMAIL_ALLOWED_DOMAINS=uma.edu.pe
